{
  "name": "action-weekly-defender-report",
  "version": "1.0.0",
  "description": "GitHub Action to send weekly vulnerability reports from Microsoft Defender",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "echo \"No tests yet\" && exit 0",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
    "github-action",
    "microsoft-defender",
    "vulnerability-report",
    "security"
  ],
  "author": "Enonic",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^9.1.1",
    "axios": "^1.16.0",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/nodemailer": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  }
}
